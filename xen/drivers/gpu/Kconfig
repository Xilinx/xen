config GPU
	bool

if ARM
menuconfig MALI_G78AE
	bool "Mali G78AE GPU support (EA)"	if EXPERT
	select GPU
	select MALI_GSI_SCHED_NULL
	default n
	help
	  Support for implementation of hardware virtualization available in the
	  Mali G78AE GPU.

if MALI_G78AE

config MALI_G78AE_VERSAL2
	bool "Mali G78AE GPU support for Versal2"
	default n
	help
	  Support for Mali G78AE GPU on Versal2 platform.

config MALI_G78AE_VERSAL_MMI_SLRC_REG_CFG_0
	hex "GPU_CORR_IRQ_CFG0 value in MMI_SLRC" if MALI_G78AE_VERSAL2
	default 0xDCBA9876
	help
	  Value for the GPU_CORR_IRQ_CFG0 register for Mali G78AE on Versal2 platform.
	  By default, this is set to 0xDCBA9876, which is the value used in the Versal2
	  on reset. This value set the first 8 IRQ lines to be used for AWs.

config MALI_G78AE_VERSAL_MMI_SLRC_REG_CFG_1
	hex "GPU_CORR_IRQ_CFG1 value in MMI_SLRC" if MALI_G78AE_VERSAL2
	default 0x00FE5432
	help
	  Value for the GPU_CORR_IRQ_CFG1 register for Mali G78AE on Versal2 platform.
	  By default, this is set to 0x00FE5432, which is the value used in the Versal2
	  on reset. This value set the next 2 IRQ lines to be used for RGs and system
	  blocks.

config MALI_GSI_SCHED_NULL
	bool "Null scheduler support"
	default y
	help
	  The null scheduler provides static GPU partitioning with no
	  time-slicing. Each VM gets exclusive, indefinite access to its
	  assigned GPU partition. Only one VM can use a partition at a time;
	  additional requests are rejected.

config MALI_GSI_SCHED_TIMESLICE
	bool "Timeslice scheduler support"
	default y
	help
	  The timeslice scheduler allows multiple VMs to share a GPU
	  partition by taking turns. Uses timer-driven preemption with
	  configurable time quantum (default 7ms). When a VM's quantum
	  expires, it receives GPU_STOP and the next VM in the queue
	  gets GPU_GRANTED.

choice
	prompt "Default GPU scheduler"
	default MALI_GSI_SCHED_TIMESLICE_DEFAULT if MALI_GSI_SCHED_TIMESLICE
	default MALI_GSI_SCHED_NULL_DEFAULT

config MALI_GSI_SCHED_NULL_DEFAULT
	bool "Null scheduler" if MALI_GSI_SCHED_NULL

config MALI_GSI_SCHED_TIMESLICE_DEFAULT
	bool "Timeslice scheduler" if MALI_GSI_SCHED_TIMESLICE

endchoice

config MALI_GSI_SCHED_DEFAULT
	string
	default "ts" if MALI_GSI_SCHED_TIMESLICE_DEFAULT
	default "null" if MALI_GSI_SCHED_NULL_DEFAULT
	default "null"

endif # MALI_G78AE

endif # ARM
