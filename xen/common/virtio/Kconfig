menu "Virtio"
	visible if EXPERT

config VIRTIO_MSG_BUS_CORE
	bool

config NR_VIRTIO_MSG_BUSES
	int "Maximum number of virtio-msg-buses supported"
	range 1 128
	default "4"
	depends on VIRTIO_MSG_BUS_CORE
	help
	  Controls the build-time size of various arrays associated with
	  management of multiple buses. It is the upper bound of
	  the number of virtio-msg-bus devices that Xen can handle.

config VIRTIO_MSG_BUS_XEN
	bool "Virtio-msg-bus Xen"
	default n
	select VIRTIO_MSG_BUS_CORE
	depends on ARM || X86
	help
	  Virtio-msg bus implementation using FIFOs on top of shared memory
	  and event channels for notifications. This is suitable for
	  communicating using virtio-msg between Xen and guests.

config VIRTIO_MMIO_NON_BLOCKING
	bool "Non-blocking virtio-mmio"
	default n
	depends on VIRTIO_MSG_BUS_CORE && (ARM || (X86 && HVM)) && DEVICE_TREE_PARSE
	help
	  Non-blocking virtio-mmio is a modified version of virtio-mmio
	  partially implemented in Xen itself allowing VMs to do virtio
	  in a way that does not pause vcpus. This allows real-time sensitive
	  guests to for example handle interrupts or do other work while
	  virtio-mmio is processing a register access. Behind the scenes,
	  Xen translates virtio-mmio into virtio-msg and adds an indirect
	  register extension to virtio-mmio.

endmenu
